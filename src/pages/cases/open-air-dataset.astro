---
// components
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/cases/CaseHeader.astro";
import Footer from "../../components/cases/CaseFooter.astro";
import CaseText from "../../components/cases/CaseText.astro";
import { languageTag } from "../../paraglide/runtime.js";

const lang = languageTag();
const fig = (name) => `/blog/images/${lang === 'ru' ? 'ru/' : ''}open-air-dataset-on-polkadot/${name}.png`;
const img = (name) => `/blog/images/open-air-dataset-on-polkadot/${name}`;
const loc = (path) => (lang === 'en' ? '' : `/${lang}`) + path;
const alt0 = await $tr('Since 1 April 2026: 19M+ readings, 100M+ values, about 300 sensors, 20+ countries');
const alt1 = await $tr('Cumulative readings by month, April to November 2026');
const alt2 = await $tr('World map of the sensors that publish to the dataset');
const alt3 = await $tr('Pollution episodes on Koh Phangan, April to September 2026');
const alt4 = await $tr('Saharan dust over Cyprus, 3 April 2026, each line one home sensor');
const alt5 = await $tr('How a reading becomes part of the commons');
const alt6 = await $tr('Data as an asset vs data as a commons');
const sLoc = (path) => `https://sensors.social${lang === 'ru' ? '/ru' : ''}${path}`;
---

<Layout
  casePath={Astro.url}
>

  <Header
    path={Astro.url.pathname}
    introText={$tr("Home air sensors in Cyprus, on Koh Phangan, on Réunion and in 20+ countries have written more than 19 million readings through Robonomics since April 2026. Since 28 September the record lives on Polkadot: an open, tamper-evident dataset of the planet’s air that belongs to everyone.")}
  />

  <section class="case-page layout">

    <CaseText
      title={$tr('Not a promise: an archive')}
      multiple
    >
      <p>{$tr('People often say data will be stored on a blockchain one day. This dataset is already there. Each sensor signs its readings, the readings are packed into files, and the fingerprint of every file is written to the chain. Anyone can open the archive today, and nobody, including us, can quietly edit or close it.')}</p>
      <img class="oad-fig" src={fig('numbers')} alt={alt0} />
      <img class="oad-fig" src={fig('growth')} alt={alt1} />
    </CaseText>

    <CaseText
      title={$tr('Where it comes from')}
      multiple
    >
      <img class="oad-fig" src={fig('map')} alt={alt2} />

      <h3>{$tr('Koh Phangan: evidence the community collected itself')}</h3>
      <p>{$tr('Five sensors went up on the island in two days in August 2025. A year later the archive showed what no daily average would: very clean background air with about 1,200 short, sharp pollution episodes inside it, mostly in the evening and mostly next to a single sensor. That is what daily trash burning looks like. Local activists call it evidence of pollution on a public blockchain.')}</p>
      <img class="oad-fig" src={img('phangan-episodes.png')} alt={alt3} />
      <p><a href={sLoc('/blog/koh-phangan-one-year-later/')} target="_blank">{$tr('Read the full Koh Phangan analysis on sensors.social')}</a></p>

      <h3>{$tr('Cyprus: one island, seventy sensors')}</h3>
      <p>{$tr('About seventy sensors and more than five million readings. In early April they followed a Saharan dust storm across seven towns hour by hour, something one official station could never show.')}</p>
      <img class="oad-fig" src={img('cyprus-dust.png')} alt={alt4} />
      <p><a href={sLoc('/blog/cyprus-saharan-dust-storm/')} target="_blank">{$tr('Read the Cyprus dust storm case on sensors.social')}</a></p>

      <h3>{$tr('Réunion, Bali, Europe and beyond')}</h3>
      <p>{$tr('Single homes on Réunion and Bali have recorded around the clock since April. Europe adds dozens more. Every new sensor puts a point where the map had none.')}</p>
    </CaseText>

    <CaseText
      title={$tr('Why a blockchain, if nobody is paying anyone')}
      multiple
    >
      <img class="oad-fig" src={fig('path')} alt={alt5} />
      <ul>
        <li><b>{$tr('Tamper-evident.')}</b> {$tr('Change one number later and it no longer matches the fingerprint that has been public since the day it was measured.')}</li>
        <li><b>{$tr('Impossible to lock up.')}</b> {$tr('The index that turns chain entries back into readings is open source. Anyone can rebuild the whole archive without asking us.')}</li>
        <li><b>{$tr('Equal access.')}</b> {$tr('A city, a university lab and a student use the same open map and the same open API, on the same terms.')}</li>
      </ul>
    </CaseText>

    <CaseText
      title={$tr('A commons, not an asset')}
      multiple
    >
      <img class="oad-fig" src={fig('commons')} alt={alt6} />
      <p>{$tr('Each owner decides whether their sensor publishes. What is published becomes common ground under an open licence. Urban researchers get a long street-level record that no single institution could afford to collect and no single institution can take away.')}</p>
    </CaseText>

    <CaseText
      title={$tr('Use it, or add to it')}
      multiple
    >
      <ul>
        <li><a href="https://sensors.social" target="_blank">{$tr('Open the live map on sensors.social')}</a></li>
        <li><a href={sLoc('/blog/open-air-dataset/')} target="_blank">{$tr('Take the data through the open API')}</a></li>
        <li><a href={loc('/blog/open-air-dataset-on-polkadot/')}>{$tr('Read the story on the Robonomics blog')}</a></li>
      </ul>
    </CaseText>

  </section>

  <Footer
    text={[$tr('Here the main result of a blockchain is not financial. Robonomics keeps an open record of the planet’s air on Polkadot, which any researcher can check and nobody can take away.')]}
    title={$tr('Conclusion')}
    link="https://github.com/airalab/sensors.social"
    linkText={$tr('sensors.social on GitHub')}
  />
</Layout>

<style>
  .oad-fig { width: 100%; height: auto; margin: 1.5rem 0; display: block; }
</style>
